<mxfile host="app.diagrams.net"><diagram id="shared-architecture" name="API edge"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Shared resources: the API edge of the calculator - one environment (dev or prod). Numbers refer to the legend below." style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="4" width="1000" height="24" as="geometry"/></mxCell><mxCell id="client" value="Client: browser of the web page (uses only the host name api.&amp;lt;site&amp;gt;)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="190" height="80" as="geometry"/></mxCell><mxCell id="gh" value="GitHub Actions (OIDC): plan, refuse any delete or replace, apply the same plan. Weights are GitHub variables API_WEIGHT_*" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="190" height="120" as="geometry"/></mxCell><mxCell id="aws" value="AWS account (one per environment), us-east-2" style="rounded=1;fillColor=none;html=1;fontSize=12;arcSize=4;strokeColor=#232F3E;verticalAlign=bottom;align=right;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="230" y="50" width="1250" height="705" as="geometry"/></mxCell><mxCell id="repo" value="This repository: module api-hostname (Terragrunt, dev and prod)" style="rounded=1;fillColor=none;html=1;fontSize=12;arcSize=4;fillColor=#fafafa;strokeColor=#666666;verticalAlign=bottom;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="250" y="90" width="830" height="630" as="geometry"/></mxCell><mxCell id="others" value="Other repositories (backends), same account" style="rounded=1;fillColor=none;html=1;fontSize=12;arcSize=4;dashed=1;fillColor=#fafafa;strokeColor=#666666;verticalAlign=bottom;align=center;" vertex="1" parent="1"><mxGeometry x="1110" y="90" width="355" height="615" as="geometry"/></mxCell><mxCell id="r53" value="Route 53 hosted zone: weighted A aliases api.&amp;lt;site&amp;gt;, one per published backend; DNS validation CNAME" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5f7;strokeColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="290" y="130" width="250" height="70" as="geometry"/></mxCell><mxCell id="acm" value="ACM certificate (regional) for api.&amp;lt;site&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="240" width="250" height="60" as="geometry"/></mxCell><mxCell id="ssmc" value="SSM /oecalc/&amp;lt;env&amp;gt;/api-certificate-arn" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="360" width="250" height="60" as="geometry"/></mxCell><mxCell id="state" value="S3 state bucket: one state file per unit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="600" width="250" height="50" as="geometry"/></mxCell><mxCell id="reg" value="SSM registry /oecalc/&amp;lt;env&amp;gt;/api-backends/&amp;lt;name&amp;gt;/{dns-name, hosted-zone-id}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="620" y="240" width="240" height="70" as="geometry"/></mxCell><mxCell id="cw" value="CloudWatch alarms: DaysToExpiry below 90, 60, 30 and 15 days" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fad7e8;strokeColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="620" y="360" width="240" height="60" as="geometry"/></mxCell><mxCell id="sns" value="SNS topic (policy: CloudWatch only, TLS only)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fad7e8;strokeColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="620" y="470" width="240" height="60" as="geometry"/></mxCell><mxCell id="mail" value="Email subscription to the support address (the owner confirms it)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fad7e8;strokeColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="620" y="580" width="240" height="60" as="geometry"/></mxCell><mxCell id="sls" value="sls: API Gateway custom domain" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6d0f2;strokeColor=#9333ea;" vertex="1" parent="1"><mxGeometry x="1140" y="140" width="290" height="70" as="geometry"/></mxCell><mxCell id="ecs" value="ecs: Application Load Balancer, HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6d0f2;strokeColor=#9333ea;" vertex="1" parent="1"><mxGeometry x="1140" y="250" width="290" height="70" as="geometry"/></mxCell><mxCell id="later" value="eks and ec2: later, same contract (dashed)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6d0f2;strokeColor=#9333ea;dashed=1;" vertex="1" parent="1"><mxGeometry x="1140" y="360" width="290" height="70" as="geometry"/></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="client" target="r53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="240"/><mxPoint x="250" y="165"/></Array></mxGeometry></mxCell><mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=1;exitY=0.5;entryX=0;entryY=0.1;" edge="1" parent="1" source="r53" target="others"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0.2;exitY=0;entryX=0.2;entryY=1;dashed=1;" edge="1" parent="1" source="acm" target="r53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="acm" target="ssmc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0;exitY=0.8;entryX=1;entryY=0.3;" edge="1" parent="1" source="sls" target="reg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1085" y="196"/><mxPoint x="1085" y="261"/></Array></mxGeometry></mxCell><mxCell id="e6" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0;exitY=0.5;entryX=1;entryY=0.7;" edge="1" parent="1" source="ecs" target="reg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1085" y="285"/><mxPoint x="1085" y="289"/></Array></mxGeometry></mxCell><mxCell id="e7" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0.5;exitY=0;entryX=0.8;entryY=1;" edge="1" parent="1" source="reg" target="r53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="220"/><mxPoint x="490" y="220"/></Array></mxGeometry></mxCell><mxCell id="e8" value="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="acm" target="cw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="270"/><mxPoint x="580" y="390"/></Array></mxGeometry></mxCell><mxCell id="e9" value="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cw" target="sns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sns" target="mail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gh" target="state"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="650"/><mxPoint x="250" y="625"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Flows&lt;/b&gt;&lt;br&gt;1 DNS: the client resolves api.&amp;lt;site&amp;gt; and Route 53 answers by weight.&amp;nbsp;&amp;nbsp;2 The client then calls the chosen backend directly (HTTPS).&amp;nbsp;&amp;nbsp;3 ACM validates the certificate with a CNAME in the zone.&amp;nbsp;&amp;nbsp;4 The certificate ARN is published in SSM; the backends read it and attach the certificate to their custom domain.&lt;br&gt;5 Each backend publishes its target (DNS name and zone ID) in the SSM registry.&amp;nbsp;&amp;nbsp;6 This repository reads the registry at plan time and creates one weighted alias per published backend.&amp;nbsp;&amp;nbsp;7 The alarms watch DaysToExpiry of the certificate.&amp;nbsp;&amp;nbsp;8 Alarms notify the SNS topic.&amp;nbsp;&amp;nbsp;9 The topic emails the support address.&lt;br&gt;10 GitHub Actions plans, reads the plan as JSON and stops on any delete or replace, applies the same plan; the state lives in S3.&lt;br&gt;&lt;br&gt;&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;Weights come from the GitHub variables API_WEIGHT_SLS, API_WEIGHT_ECS, API_WEIGHT_EKS and API_WEIGHT_EC2 (0 to 255, unset counts as 0); a backend that has not published its target gets no record, and a plan where every published backend has weight 0 is refused. Changing a weight means changing the variable and running Deploy by hand: only this repository deploys, the web page does not. Trust boundaries: Internet to Route 53 and the backends; GitHub to AWS through OIDC; SSM is the only link between repositories. Not here: the web page and Cognito (webpage repository), the backends, the deployment roles and the hosted zone." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=6;strokeColor=#bbbbbb;rounded=0;" vertex="1" parent="1"><mxGeometry x="250" y="775" width="1215" height="215" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
