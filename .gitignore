# Terragrunt cache (generated, never commit)
**/.terragrunt-cache/

# Files generated by Terragrunt on every init
**/backend.tf
**/provider.tf

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
**/*.tfplan
**/tfplan

# Local secrets (ROUTE53_ZONE_ID and weights when running Terragrunt by hand)
**/secrets.yml

# Local working papers (specs and project notes): never versioned
specs/
ai-related-docs/

# Editors and OS
.vscode/
.DS_Store
Thumbs.db
.claude/
